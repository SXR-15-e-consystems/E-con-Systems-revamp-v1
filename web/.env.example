# ============================================================================
# Web Frontend Environment Variables
# ============================================================================

# API Base URL (REQUIRED in production)
# Points to the FastAPI backend server
# Development: http://localhost:8000/api/v1
# Production: https://api.yourdomain.com/api/v1
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1

# Revalidation Interval (seconds)
# How often Next.js should revalidate static pages (ISR)
# Default: 60 seconds
REVALIDATE_SECONDS=60

# Node Environment
# Automatically set by Next.js, but can be overridden
# Values: development | production | test
NODE_ENV=development

# ============================================================================
# Notes:
# - All NEXT_PUBLIC_* variables are embedded in client-side JavaScript
# - The app will throw an error if NEXT_PUBLIC_API_BASE_URL is missing in production
# - Never commit secrets or API keys to this file
# ============================================================================
