# Bytecode — cover ALL locations
**/__pycache__/
*.py[cod]
*.pyo
*.pyd

# Virtual environments
.venv/
venv/
env/

# Distribution / packaging
*.egg-info/
*.egg
build/

# ──────────────────────────────────────────────────────────────
# Node.js (cms/, web/)
# ──────────────────────────────────────────────────────────────

node_modules/

# Build outputs
.next/
dist/
out/
cms/dist/

# Parcel / misc cache
.cache/

# ──────────────────────────────────────────────────────────────
# Environment & Secrets — NEVER commit real credentials
# ──────────────────────────────────────────────────────────────

.env
.env.local
.env.*.local
.env.production
.env.staging

# Scratch credentials file (real secrets — must stay off GitHub)
downloadformsamples/credentials.txt

