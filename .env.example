MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=econ_platform_poc
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]
NODE_ENV=development

# JWT Configuration
JWT_SECRET_KEY=change-me-generate-with-openssl-rand-hex-32
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Cookie security (set true in production with HTTPS)
SECURE_COOKIES=false

# Auto-seed admin user (used only when DB has zero users)
ADMIN_EMAIL=admin@econ.com
ADMIN_PASSWORD=Admin@12345678

# MS SQL (econ + econshopping databases)
# MSSQL_PASSWORD intentionally blank here — fill in your local .env (gitignored)
MSSQL_HOST=192.168.8.47
MSSQL_ECON_DB=econ
MSSQL_USER=econ
MSSQL_PASSWORD=

# Frontend
VITE_API_BASE_URL=http://localhost:8000/api/v1
