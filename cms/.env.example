# CMS environment variables
# Copy this file to .env and fill in the values for your environment.
# NEVER commit the real .env file to version control.

# Base URL of the public-facing Next.js web app (used for preview links)
VITE_PUBLIC_SITE_URL=http://localhost:3000

# Base URL of the FastAPI backend API
VITE_API_BASE_URL=http://localhost:8000/api/v1

# Session idle timeout in milliseconds before auto-logout (default: 30 minutes)
# Set to 0 to disable
VITE_IDLE_TIMEOUT_MS=1800000
